# Template only: Spring Boot does not load this file automatically.
# Select SPRING_PROFILES_ACTIVE=dev explicitly for local work. It supplies only
# non-sensitive database host, port, and name defaults plus Hibernate update;
# DB_USER, DB_PASS, and JWT_SECRET remain required.
# With no profile selected, the application fails closed. Never use dev in
# production.
#
# For production, set these in the backend service's private environment.
# Use Spring Boot's standard profile setting for Render.
# Never commit real credentials or secret values.

# Required for a production deployment. Spell the profile exactly.
SPRING_PROFILES_ACTIVE=prod

# Required PostgreSQL settings. Alternatively, configure all three standard
# datasource overrides: SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME,
# and SPRING_DATASOURCE_PASSWORD. DATABASE_URL alone is not consumed.
DB_HOST=your_postgres_private_host
DB_PORT=your_postgres_port
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=replace_with_private_database_password

# Required in production. Generate a private random secret of at least 32 bytes.
JWT_SECRET=replace_with_private_random_secret_at_least_32_bytes

# Set this to a directory on the Render persistent disk.
# Example if the disk is mounted at /var/data:
APP_UPLOAD_DIR=/var/data/taskmanagerpro/attachments

# Optional email settings; email is disabled by default.
MAIL_ENABLED=false
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

# PORT is assigned by Render; do not set it here for the hosted service.
# Set APP_CORS_ALLOWED_ORIGINS privately to the exact frontend origin(s),
# comma-separated, when they differ from the built-in current origin.
